# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Model Deployments
EMBEDDING_DEPLOYMENT=text-embedding-ada-002
CHAT_DEPLOYMENT=gpt-4

# Azure Cognitive Search (if using)
SEARCH_ENDPOINT=https://your-search.search.windows.net
SEARCH_API_KEY=your-search-key-here
SEARCH_INDEX_NAME=sor-documents

# Alternative: OpenAI API (if not using Azure)
# OPENAI_API_KEY=sk-...
# OPENAI_ORGANIZATION=org-...

# API Configuration
PORT=5000
FLASK_DEBUG=False  # WARNING: Set to True ONLY in development! Never in production!

# Optional: Azure Key Vault (for production)
# AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# Optional: Application Insights (for monitoring)
# APPINSIGHTS_INSTRUMENTATIONKEY=your-instrumentation-key
